# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Discord application ID
CLIENT_ID=your_client_id_here

# Discord server ID for guild-specific commands (optional)
GUILD_ID=your_guild_id_here

# Obsidian vault path (absolute path to your vault folder)
OBSIDIAN_VAULT_PATH=

# Obsidian notes subfolder within vault (default: DM-Overlord)
OBSIDIAN_SUBFOLDER=DM-Overlord

# Database path (default: ./data/dm-overlord.db)
DATABASE_PATH=./data/dm-overlord.db

# DM Narration style: descriptive, cinematic, minimal, humorous (default: descriptive)
NARRATION_STYLE=descriptive

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# AI provider: openai or claude (default: openai)
AI_PROVIDER=openai

# OpenAI API key (used when AI_PROVIDER=openai)
OPENAI_API_KEY=

# Claude API key (used when AI_PROVIDER=claude)
CLAUDE_API_KEY=

# Claude API base URL (optional — set for self-hosted/proxied endpoints like Hermes GCP)
CLAUDE_BASE_URL=

# Web UI port (default: 3000)
WEB_PORT=3000

# Web UI host (default: localhost). Set to 0.0.0.0 to expose on all interfaces.
WEB_HOST=localhost

# AI model for parsing
# OpenAI: gpt-4o-mini (default), gpt-4o, gpt-4-turbo
# Claude: claude-3-5-sonnet-20241022 (default), claude-3-opus-20240229
AI_MODEL=gpt-4o-mini

# Web DM password — if set, the web UI requires this password to access DM features.
# Without it, all users have full DM access (no login required).
# Players without login can only use Dice Roller and Maps.
WEB_DM_PASSWORD=

# Base URL for map links in Discord messages (e.g., https://dm-overlord.example.com)
# Defaults to http://localhost:3000
WEB_BASE_URL=
