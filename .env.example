# Discord bot token from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here

# Discord application ID
CLIENT_ID=your_client_id_here

# Discord server ID for guild-specific commands (optional)
GUILD_ID=your_guild_id_here

# Obsidian vault path (absolute path to your vault folder)
OBSIDIAN_VAULT_PATH=

# Obsidian notes subfolder within vault (default: DM-Overlord)
OBSIDIAN_SUBFOLDER=DM-Overlord

# Database path (default: ./data/dm-overlord.db)
DATABASE_PATH=./data/dm-overlord.db

# DM Narration style: descriptive, cinematic, minimal, humorous (default: descriptive)
NARRATION_STYLE=descriptive

# Logging level: debug, info, warn, error
LOG_LEVEL=info

# OpenAI API key (required for AI-powered PDF parsing)
OPENAI_API_KEY=

# AI model for parsing (default: gpt-4o-mini — cheap & fast)
AI_MODEL=gpt-4o-mini
